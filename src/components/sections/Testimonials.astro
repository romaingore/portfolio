---
import { TESTIMONIALS } from "@/config/site";
import { Image } from "astro:assets";
---

<section id="testimonials" class="bg-white py-16 dark:bg-gray-950 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center">
            <h2
                class="text-base font-semibold uppercase tracking-wide text-primary-600 dark:text-primary-400"
            >
                Testimonials
            </h2>
            <p
                class="mt-2 text-3xl font-extrabold text-gray-900 dark:text-white sm:text-4xl"
            >
                Loved by developers
            </p>
        </div>
        <div
            class="mx-auto mt-16 grid max-w-2xl grid-cols-1 gap-8 lg:mx-0 lg:max-w-none lg:grid-cols-3"
        >
            {
                TESTIMONIALS.map((testimonial) => (
                    <div class="flex flex-col justify-between rounded-lg bg-gray-50 p-8 shadow-sm dark:bg-gray-900">
                        <div>
                            <div class="flex items-center gap-x-4">
                                <img
                                    class="h-12 w-12 rounded-full bg-gray-50"
                                    src={testimonial.avatar}
                                    alt={testimonial.name}
                                    loading="lazy"
                                />
                                <div>
                                    <h3 class="text-lg font-semibold leading-7 tracking-tight text-gray-900 dark:text-white">
                                        {testimonial.name}
                                    </h3>
                                    <p class="text-sm font-semibold leading-6 text-primary-600 dark:text-primary-400">
                                        {testimonial.role}
                                    </p>
                                </div>
                            </div>
                            <blockquote class="mt-6 text-gray-700 dark:text-gray-300">
                                <p>"{testimonial.text}"</p>
                            </blockquote>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
