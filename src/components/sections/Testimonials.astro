---
import { TESTIMONIALS } from "@/config/site";
---

<section id="temoignages" class="bg-primary-950 py-20 sm:py-28">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="text-center">
            <span
                class="text-xs font-semibold uppercase tracking-[0.15em] text-primary-400"
            >
                Témoignage
            </span>
            <h2
                class="mt-3 font-serif text-4xl font-semibold text-white sm:text-5xl"
            >
                Ce qu'ils en disent
            </h2>
        </div>

        <!-- Testimonials -->
        <div class="mt-16 space-y-12">
            {
                TESTIMONIALS.map((testimonial) => (
                    <div class="relative">
                        <!-- Decorative quote mark -->
                        <span
                            class="absolute -left-2 -top-6 font-serif text-[8rem] leading-none text-primary-800 select-none"
                            aria-hidden="true"
                        >
                            "
                        </span>

                        <blockquote class="relative z-10">
                            <p class="font-serif text-2xl italic leading-relaxed text-primary-100 sm:text-3xl">
                                "{testimonial.text}"
                            </p>

                            <footer class="mt-8 flex items-center gap-4">
                                <!-- Avatar initials -->
                                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-primary-800">
                                    <span class="font-serif text-lg font-semibold text-primary-300">
                                        {testimonial.name.charAt(0)}
                                    </span>
                                </div>
                                <div>
                                    <p class="font-semibold text-white">
                                        {testimonial.name}
                                    </p>
                                    <p class="text-sm text-primary-400">
                                        {testimonial.role}
                                    </p>
                                </div>
                            </footer>
                        </blockquote>
                    </div>
                ))
            }
        </div>
    </div>
</section>
