---
---

<section id="contact" class="bg-white py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div
            class="relative overflow-hidden rounded-2xl bg-primary-950 px-8 py-16 shadow-xl sm:px-16 sm:py-20"
        >
            <!-- Decorative circles -->
            <div
                class="pointer-events-none absolute -right-24 -top-24 h-64 w-64 rounded-full bg-primary-800/50"
                aria-hidden="true"
            >
            </div>
            <div
                class="pointer-events-none absolute -bottom-16 -left-16 h-48 w-48 rounded-full bg-primary-900/60"
                aria-hidden="true"
            >
            </div>

            <div class="relative z-10 mx-auto max-w-2xl text-center">
                <span
                    class="text-xs font-semibold uppercase tracking-[0.15em] text-primary-400"
                >
                    Contact
                </span>
                <h2
                    class="mt-4 font-serif text-4xl font-semibold leading-tight text-white sm:text-5xl"
                >
                    Prêt à avoir un site<br />
                    qui travaille pour vous ?
                </h2>
                <p class="mt-6 text-lg leading-relaxed text-primary-300">
                    Envoyez-moi un message, je réponds sous 48h. Pas
                    d'engagement — juste un échange pour voir si je peux vous
                    aider.
                </p>

                <div
                    class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row"
                >
                    <a
                        href="mailto:romain.gore@outlook.com"
                        class="inline-flex items-center gap-2 rounded-sm bg-primary-500 px-8 py-3.5 text-base font-semibold text-white transition-colors hover:bg-primary-400"
                    >
                        <svg
                            class="h-4 w-4"
                            viewBox="0 0 20 20"
                            fill="currentColor"
                            aria-hidden="true"
                        >
                            <path
                                d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"
                            ></path>
                            <path
                                d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"
                            ></path>
                        </svg>
                        romain.gore@outlook.com
                    </a>
                    <a
                        href="#offres"
                        class="text-sm font-semibold text-primary-300 underline-offset-4 hover:text-white hover:underline"
                    >
                        Voir les offres →
                    </a>
                </div>

                <!-- Trust line -->
                <p class="mt-10 text-sm text-primary-500">
                    Devis gratuit · Réponse sous 48h · Pas d'engagement
                </p>
            </div>
        </div>
    </div>
</section>
