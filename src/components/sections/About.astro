---
import { Image } from 'astro:assets';
import photoPro from '../../assets/romain-gore-developpeur-web-bretagne.jpg';
---

<section id="a-propos" class="bg-white pt-24 pb-8">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">

        <!-- Ligne du haut : photo + texte -->
        <div class="grid grid-cols-1 items-center gap-16 lg:grid-cols-2">

            <!-- Colonne gauche : photo -->
            <div data-about="images" class="relative flex justify-center">
                <div class="h-[360px] w-[360px] overflow-hidden rounded-full shadow-2xl">
                    <Image
                        src={photoPro}
                        alt="Romain Goré, développeur web"
                        width={720}
                        height={1040}
                        quality={85}
                        class="h-full w-full object-cover object-top"
                    />
                </div>
            </div>

            <!-- Colonne droite : texte -->
            <div data-about="text">
                <p class="mb-4 text-xs font-semibold uppercase tracking-[0.18em] text-primary-500">
                    À propos
                </p>
                <h2 class="font-serif text-4xl font-semibold leading-tight text-primary-950 sm:text-5xl">
                    Un développeur <em class="italic text-primary-500">proche de vous</em>
                </h2>
                <p class="mt-6 text-base leading-relaxed text-primary-800">
                    Je m'appelle Romain, développeur web indépendant basé à Angers. Je crée des sites sur mesure pour les artisans et petites entreprises — du vrai code pensé pour être rapide, visible sur Google et facile à entretenir.
                </p>
                <p class="mt-4 text-base leading-relaxed text-primary-800">
                    Pas d'agence, pas d'intermédiaire. De la première discussion à la mise en ligne, vous travaillez directement avec moi. Simple, réactif, sans mauvaises surprises.
                </p>

                <a
                    href="#contact"
                    class="mt-10 inline-block rounded-sm bg-primary-500 px-7 py-3.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-primary-600"
                >
                    Me contacter
                </a>
            </div>

        </div>

        <!-- Bullet points en 2 colonnes sous la photo -->
        <ul class="mt-16 grid grid-cols-1 gap-4 sm:grid-cols-2">
            {[
                { icon: "M13 10V3L4 14h7v7l9-11h-7z", text: "Sites codés sur mesure, ultra-rapides et optimisés Google" },
                { icon: "M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z", text: "SEO local ciblé sur votre ville et votre métier" },
                { icon: "M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z", text: "100 % pensé mobile — plus de 70 % des recherches locales" },
                { icon: "M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z", text: "Un seul interlocuteur, joignable par SMS, mail ou téléphone" },
                { icon: "M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z", text: "Fiche Google Business optimisée — pour apparaître dans les recherches locales et sur Maps" },
                { icon: "M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z", text: "Analytics et Search Console intégrés dès le départ" },
                { icon: "M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01", text: "Hébergement, sauvegardes et mises à jour gérés pour vous" },
            ].map(({ icon, text }) => (
                <li class="flex items-start gap-3">
                    <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-primary-50">
                        <svg class="h-4 w-4 text-primary-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d={icon} />
                        </svg>
                    </span>
                    <span class="text-sm leading-relaxed text-primary-800">{text}</span>
                </li>
            ))}
        </ul>

    </div>
</section>
