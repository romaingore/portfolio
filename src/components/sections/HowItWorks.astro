---
const steps = [
    {
        num: "01",
        title: "On échange",
        desc: "Un appel ou quelques messages suffisent. Je comprends votre métier, vos besoins et ce que vos clients recherchent.",
    },
    {
        num: "02",
        title: "Je développe",
        desc: "Je conçois et code votre site. Vous suivez l'avancement et donnez vos retours. Deux allers-retours de révision inclus.",
    },
    {
        num: "03",
        title: "C'est en ligne",
        desc: "Votre site est mis en ligne après validation et paiement du solde. Google reçoit votre fiche et le site est indexé.",
    },
];
---

<section id="processus" class="bg-white py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="mx-auto max-w-2xl text-center">
            <span
                class="text-xs font-semibold uppercase tracking-[0.15em] text-primary-500"
            >
                Processus
            </span>
            <h2
                class="mt-3 font-serif text-4xl font-semibold text-primary-950 sm:text-5xl"
            >
                Comment ça marche ?
            </h2>
            <p class="mt-4 text-lg leading-relaxed text-primary-800">
                Trois étapes simples pour avoir votre site en ligne.
            </p>
        </div>

        <!-- Steps -->
        <div class="relative mt-20">
            <!-- Connecting line (desktop) -->
            <div
                class="absolute left-[calc(16.7%+2.5rem)] right-[calc(16.7%+2.5rem)] top-8 hidden h-px bg-primary-200 lg:block"
                aria-hidden="true"
            >
            </div>

            <div
                id="steps-grid"
                class="grid grid-cols-1 gap-12 lg:grid-cols-3 lg:gap-0"
            >
                {
                    steps.map((step) => (
                        <div class="relative flex flex-col items-center px-8 text-center">
                            <!-- Step circle -->
                            <div class="relative z-10 flex h-16 w-16 shrink-0 items-center justify-center rounded-full border-2 border-primary-300 bg-white shadow-sm">
                                <span class="font-serif text-lg font-semibold text-primary-500">
                                    {step.num}
                                </span>
                            </div>

                            <h3 class="mt-7 font-serif text-2xl font-semibold text-primary-950">
                                {step.title}
                            </h3>
                            <p class="mt-3 max-w-xs text-sm leading-relaxed text-primary-700">
                                {step.desc}
                            </p>
                        </div>
                    ))
                }
            </div>
        </div>

        <!-- CTA nudge -->
        <div class="mt-16 text-center">
            <a
                href="mailto:romain.gore@outlook.com"
                class="inline-flex items-center gap-2 text-sm font-semibold text-primary-600 underline-offset-4 hover:text-primary-500 hover:underline"
            >
                Lancer mon projet
                <svg
                    class="h-4 w-4"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    aria-hidden="true"
                >
                    <path
                        fill-rule="evenodd"
                        d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                        clip-rule="evenodd"
                    ></path>
                </svg>
            </a>
        </div>
    </div>
</section>
