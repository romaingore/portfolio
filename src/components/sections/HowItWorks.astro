---
const steps = [
    {
        num: "01",
        title: "On échange",
        desc: "Un appel ou quelques messages suffisent. Je comprends votre métier, vos besoins et ce que vos clients recherchent.",
    },
    {
        num: "02",
        title: "Je développe",
        desc: "Je conçois et code votre site. Vous suivez l'avancement et donnez vos retours. Deux allers-retours de révision inclus.",
    },
    {
        num: "03",
        title: "C'est en ligne",
        desc: "Votre site est mis en ligne après validation et paiement du solde. Google reçoit votre fiche et le site est indexé.",
    },
];
---

<section id="processus" class="bg-primary-50 py-20 sm:py-28">
    <div class="mx-auto max-w-6xl px-6">

        <!-- Header -->
        <div class="mx-auto max-w-2xl text-center">
            <span class="text-xs font-semibold uppercase tracking-[0.15em] text-primary-500">
                Processus
            </span>
            <h2 class="mt-3 font-serif text-4xl font-semibold text-primary-950 sm:text-5xl">
                Comment ça marche ?
            </h2>
            <p class="mt-4 text-lg leading-relaxed text-primary-800">
                Trois étapes simples pour avoir votre site en ligne.
            </p>
        </div>

        <!-- Roadmap -->
        <div class="relative mt-20 mx-auto max-w-2xl lg:max-w-none">

            <!-- Ligne verticale de fond (grise) -->
            <div class="roadmap-track absolute left-6 top-0 bottom-0 w-px bg-primary-200 lg:left-1/2"></div>

            <!-- Ligne de progression (se remplit au scroll) -->
            <div id="roadmap-progress" class="absolute left-6 top-0 w-px bg-primary-500 origin-top lg:left-1/2" style="height: 0%;"></div>

            <div class="space-y-16 lg:space-y-0">
                {steps.map((step, i) => (
                    <div
                        class:list={[
                            "roadmap-step relative flex items-start gap-8 opacity-0 transition-all duration-700 lg:items-center lg:gap-0",
                            i % 2 === 0 ? "lg:flex-row" : "lg:flex-row-reverse",
                        ]}
                        data-step={i}
                    >
                        <!-- Contenu -->
                        <div class:list={[
                            "pl-16 lg:pl-0 lg:w-[calc(50%-2.5rem)]",
                            i % 2 === 0 ? "lg:text-right lg:pr-12" : "lg:text-left lg:pl-12",
                        ]}>
                            <span class="text-xs font-semibold uppercase tracking-[0.15em] text-primary-400">{step.num}</span>
                            <h3 class="mt-1 font-serif text-2xl font-semibold text-primary-950">{step.title}</h3>
                            <p class="mt-2 text-sm leading-relaxed text-primary-700">{step.desc}</p>
                        </div>

                        <!-- Nœud central -->
                        <div class="roadmap-node absolute left-6 -translate-x-1/2 flex h-5 w-5 items-center justify-center rounded-full border-2 border-primary-300 bg-primary-50 transition-all duration-500 lg:left-1/2 lg:static lg:translate-x-0 lg:shrink-0 lg:mx-auto">
                            <div class="roadmap-dot h-2 w-2 rounded-full bg-primary-300 transition-all duration-500"></div>
                        </div>

                        <!-- Spacer côté opposé sur desktop -->
                        <div class="hidden lg:block lg:w-[calc(50%-2.5rem)]"></div>
                    </div>
                ))}
            </div>
        </div>

        <!-- CTA -->
        <div class="mt-16 text-center">
            <a
                href="mailto:romain.gore@outlook.com"
                class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary-600 underline-offset-4 hover:text-primary-500 hover:underline"
            >
                Lancer mon projet
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
        </div>
    </div>
</section>

<script>
    const section = document.getElementById("processus");
    const progress = document.getElementById("roadmap-progress");
    const steps = document.querySelectorAll<HTMLElement>(".roadmap-step");
    const nodes = document.querySelectorAll<HTMLElement>(".roadmap-node");
    const dots  = document.querySelectorAll<HTMLElement>(".roadmap-dot");

    function update() {
        if (!section || !progress) return;
        const rect = section.getBoundingClientRect();
        const sectionH = section.offsetHeight;
        // Fraction de la section scrollée (0 → 1)
        const scrolled = Math.max(0, Math.min(1, (-rect.top + window.innerHeight * 0.75) / sectionH));
        progress.style.height = (scrolled * 100) + "%";

        steps.forEach((step, i) => {
            const threshold = (i + 0.4) / steps.length;
            const active = scrolled >= threshold;
            step.style.opacity = active ? "1" : "0";
            step.style.transform = active ? "translateY(0)" : "translateY(16px)";
            if (active) {
                nodes[i].style.borderColor = "var(--color-primary-500)";
                dots[i].style.background   = "var(--color-primary-500)";
                dots[i].style.transform    = "scale(1.3)";
            } else {
                nodes[i].style.borderColor = "";
                dots[i].style.background   = "";
                dots[i].style.transform    = "";
            }
        });
    }

    window.addEventListener("scroll", update, { passive: true });
    update();
</script>
