---
import { PRICING_PLANS } from "@/config/site";
---

<section id="offres" class="bg-primary-50 py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="mx-auto max-w-2xl text-center">
            <span
                class="text-xs font-semibold uppercase tracking-[0.15em] text-primary-500"
            >
                Offres
            </span>
            <h2
                class="mt-3 font-serif text-4xl font-semibold text-primary-950 sm:text-5xl"
            >
                Des tarifs clairs, sans surprise
            </h2>
            <p class="mt-4 text-lg leading-relaxed text-primary-800">
                Choisissez le pack adapté à votre situation. Acompte de 50&nbsp;%
                à la commande, solde avant mise en ligne.
            </p>
        </div>

        <!-- Cards -->
        <div
            id="pricing-grid"
            class="mt-16 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3"
        >
            {
                PRICING_PLANS.map((plan) => (
                    <div
                        class:list={[
                            "relative flex flex-col rounded-xl border p-8 transition-shadow",
                            plan.popular
                                ? "border-primary-500 bg-primary-500 shadow-lg"
                                : "border-primary-100 bg-white hover:shadow-sm",
                        ]}
                    >
                        {plan.popular && (
                            <div class="absolute -top-3.5 left-1/2 -translate-x-1/2">
                                <span class="rounded-full bg-primary-950 px-4 py-1 text-xs font-semibold uppercase tracking-wide text-white">
                                    Le plus choisi
                                </span>
                            </div>
                        )}

                        <div class="mb-6">
                            <h3
                                class:list={[
                                    "font-serif text-2xl font-semibold",
                                    plan.popular
                                        ? "text-white"
                                        : "text-primary-950",
                                ]}
                            >
                                {plan.name}
                            </h3>
                            <div class="mt-4 flex items-baseline gap-2">
                                <span
                                    class:list={[
                                        "font-serif text-4xl font-semibold",
                                        plan.popular
                                            ? "text-white"
                                            : "text-primary-950",
                                    ]}
                                >
                                    {plan.price}
                                </span>
                                <span
                                    class:list={[
                                        "text-sm",
                                        plan.popular
                                            ? "text-primary-200"
                                            : "text-primary-600",
                                    ]}
                                >
                                    {plan.suffix}
                                </span>
                            </div>
                            <p
                                class:list={[
                                    "mt-2 text-sm leading-relaxed",
                                    plan.popular
                                        ? "text-primary-100"
                                        : "text-primary-700",
                                ]}
                            >
                                {plan.description}
                            </p>
                        </div>

                        <!-- Divider -->
                        <div
                            class:list={[
                                "mb-6 h-px",
                                plan.popular
                                    ? "bg-primary-400"
                                    : "bg-primary-100",
                            ]}
                        />

                        <ul class="mb-8 space-y-3 text-sm">
                            {plan.features.map((feature) => (
                                <li class="flex items-start gap-3">
                                    <svg
                                        class:list={[
                                            "mt-0.5 h-4 w-4 shrink-0",
                                            plan.popular
                                                ? "text-primary-200"
                                                : "text-primary-500",
                                        ]}
                                        viewBox="0 0 20 20"
                                        fill="currentColor"
                                        aria-hidden="true"
                                    >
                                        <path
                                            fill-rule="evenodd"
                                            d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                                            clip-rule="evenodd"
                                        />
                                    </svg>
                                    <span
                                        class:list={[
                                            plan.popular
                                                ? "text-primary-100"
                                                : "text-primary-800",
                                        ]}
                                    >
                                        {feature}
                                    </span>
                                </li>
                            ))}
                        </ul>

                        <a
                            href="mailto:romain.gore@outlook.com"
                            class:list={[
                                "mt-auto block rounded-sm px-4 py-3 text-center text-sm font-semibold transition-colors",
                                plan.popular
                                    ? "bg-white text-primary-600 hover:bg-primary-50"
                                    : "bg-primary-500 text-white hover:bg-primary-600",
                            ]}
                        >
                            {plan.cta}
                        </a>
                    </div>
                ))
            }
        </div>

        <!-- Options mention -->
        <div class="mt-10 rounded-xl border border-primary-200 bg-white p-6">
            <p class="text-center text-sm text-primary-700">
                <span class="font-semibold text-primary-900"
                    >Options disponibles :</span
                >
                &nbsp;Hébergement & maintenance <span
                    class="text-primary-500">(25 €/mois)</span
                > · Rédaction de contenu <span class="text-primary-500"
                    >(+50 €)</span
                >
                &nbsp;—&nbsp;
                <a
                    href="mailto:romain.gore@outlook.com"
                    class="font-medium text-primary-600 underline-offset-2 hover:underline"
                >
                    Me demander un devis
                </a>
            </p>
        </div>
    </div>
</section>
