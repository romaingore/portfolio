---
import { FAQS } from "@/config/site";
---

<section id="faq" class="bg-white py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-16 lg:grid-cols-3">
            <!-- Left: heading -->
            <div class="lg:col-span-1">
                <span
                    class="text-xs font-semibold uppercase tracking-[0.15em] text-primary-500"
                >
                    FAQ
                </span>
                <h2
                    class="mt-3 font-serif text-4xl font-semibold text-primary-950 sm:text-5xl"
                >
                    Questions fréquentes
                </h2>
                <p class="mt-4 text-base leading-relaxed text-primary-700">
                    Une autre question ? Écrivez-moi directement.
                </p>
                <a
                    href="#contact"
                    class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-primary-600 underline-offset-4 hover:text-primary-500 hover:underline"
                >
                    romain.gore@outlook.com
                    <svg
                        class="h-4 w-4"
                        viewBox="0 0 20 20"
                        fill="currentColor"
                        aria-hidden="true"
                    >
                        <path
                            d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"
                        ></path>
                        <path
                            d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"
                        ></path>
                    </svg>
                </a>
            </div>

            <!-- Right: accordion -->
            <div class="lg:col-span-2">
                <div class="divide-y divide-primary-100">
                    {
                        FAQS.map((faq) => (
                            <details class="group py-6">
                                <summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-left">
                                    <span class="text-base font-semibold text-primary-950 group-open:text-primary-600">
                                        {faq.question}
                                    </span>
                                    <svg
                                        class="mt-0.5 h-5 w-5 shrink-0 rotate-0 text-primary-500 transition-transform duration-200 group-open:rotate-180"
                                        viewBox="0 0 20 20"
                                        fill="currentColor"
                                        aria-hidden="true"
                                    >
                                        <path
                                            fill-rule="evenodd"
                                            d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"
                                            clip-rule="evenodd"
                                        />
                                    </svg>
                                </summary>
                                <p class="mt-3 pr-11 text-sm leading-relaxed text-primary-700">
                                    {faq.answer}
                                </p>
                            </details>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
</section>
