---
import { FAQS } from "@/config/site";
---

<section id="faq" class="bg-gray-50 py-16 dark:bg-gray-900 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-2xl text-center">
            <h2
                class="text-base font-semibold uppercase tracking-wide text-primary-600 dark:text-primary-400"
            >
                FAQ
            </h2>
            <p
                class="mt-2 text-3xl font-extrabold text-gray-900 dark:text-white sm:text-4xl"
            >
                Frequently Asked Questions
            </p>
        </div>
        <div
            class="mx-auto mt-12 max-w-2xl divide-y divide-gray-200 dark:divide-gray-800"
        >
            {
                FAQS.map((faq) => (
                    <details class="group py-6 pt-6">
                        <summary class="flex w-full cursor-pointer items-start justify-between text-left text-gray-900 dark:text-white sm:text-lg">
                            <span class="font-medium text-gray-900 dark:text-white font-sans">
                                {faq.question}
                            </span>
                            <span class="ml-6 flex h-7 items-center">
                                <svg
                                    class="h-6 w-6 rotate-0 transform text-primary-600 transition-transform duration-200 group-open:-rotate-180 dark:text-primary-400"
                                    xmlns="http://www.w3.org/2000/svg"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke-width="1.5"
                                    stroke="currentColor"
                                    aria-hidden="true"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M19.5 8.25l-7.5 7.5-7.5-7.5"
                                    />
                                </svg>
                            </span>
                        </summary>
                        <p class="mt-2 pr-12 text-base text-gray-500 dark:text-gray-400">
                            {faq.answer}
                        </p>
                    </details>
                ))
            }
        </div>
    </div>
</section>
