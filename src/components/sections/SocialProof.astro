---
---

<section id="socialproof" class="bg-white pt-8 pb-14">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div
            class="grid grid-cols-2 divide-x divide-primary-100 md:grid-cols-4"
        >
            <div class="stat-item px-6 py-4 text-center first:pl-0 last:pr-0">
                <p class="font-serif text-4xl font-semibold text-primary-500">
                    <span class="counter" data-target="0" data-from="100">0</span>€
                </p>
                <p class="mt-1 text-sm font-medium text-primary-900">Devis gratuit</p>
                <p class="mt-0.5 text-xs text-primary-600/70">Sans engagement</p>
            </div>
            <div class="stat-item px-6 py-4 text-center">
                <p class="font-serif text-4xl font-semibold text-primary-500">
                    <span class="counter" data-target="8">0</span>j
                </p>
                <p class="mt-1 text-sm font-medium text-primary-900">Délai de livraison</p>
                <p class="mt-0.5 text-xs text-primary-600/70">Délai minimum</p>
            </div>
            <div class="stat-item px-6 py-4 text-center">
                <p class="font-serif text-4xl font-semibold text-primary-500">
                    <span class="counter" data-target="100">0</span>%
                </p>
                <p class="mt-1 text-sm font-medium text-primary-900">Sur mesure</p>
                <p class="mt-0.5 text-xs text-primary-600/70">Aucun template, aucun compromis</p>
            </div>
            <div class="stat-item px-6 py-4 text-center">
                <p class="font-serif text-4xl font-semibold text-primary-500">
                    <span class="counter" data-target="48">0</span>h
                </p>
                <p class="mt-1 text-sm font-medium text-primary-900">Délai de réponse</p>
                <p class="mt-0.5 text-xs text-primary-600/70">SMS, mail ou téléphone</p>
            </div>
        </div>
    </div>
</section>
