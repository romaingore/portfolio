---
import { Image } from 'astro:assets';
import screenshotGoreCouverture from '../../assets/site-gore-couverture-reference.png';

const projects = [
    {
        name: "Gore Couverture",
        url: "gore-couverture.fr",
        href: "https://gore-couverture.fr",
        metier: "Couvreur — Centre Bretagne, Loudéac",
        description: "Site vitrine pour une entreprise de couverture artisanale. Livré en 8 jours.",
        year: "2026",
        image: screenshotGoreCouverture,
        alt: "Site web gore-couverture.fr — couvreur Centre Bretagne",
    },
];
---

<section id="realisations" class="relative overflow-hidden bg-primary-50 py-20 sm:py-28">
    <!-- Blobs décoratifs -->


    <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">

        <div class="mx-auto max-w-2xl text-center">
            <span class="text-xs font-semibold uppercase tracking-[0.15em] text-primary-500">
                Réalisations
            </span>
            <h2 class="mt-3 font-serif text-4xl font-semibold text-primary-950 sm:text-5xl">
                Des sites qui parlent d'eux-mêmes
            </h2>
            <p class="mt-4 text-lg leading-relaxed text-primary-800">
                Chaque projet est unique, codé sur mesure, livré dans les délais.
            </p>
        </div>

        <div class="mt-16 grid grid-cols-1 gap-5 sm:grid-cols-2">
            {projects.map((project) => (
                <div class="group overflow-hidden rounded-2xl border border-primary-100 bg-primary-50">
                    <!-- Screenshot -->
                    <div class="overflow-hidden">
                        <Image
                            src={project.image}
                            alt={project.alt}
                            width={800}
                            quality={85}
                            class="w-full object-cover object-top"
                        />
                    </div>
                    <!-- Infos -->
                    <div class="p-6">
                        <div class="flex items-center justify-between">
                            <h3 class="font-serif text-xl font-semibold text-primary-950">{project.name}</h3>
                            <span class="rounded-full border border-primary-200 px-3 py-0.5 text-xs font-medium text-primary-500">{project.year}</span>
                        </div>
                        <p class="mt-1 text-xs font-medium uppercase tracking-widest text-primary-400">{project.metier}</p>
                        <p class="mt-3 text-sm leading-relaxed text-primary-700">{project.description}</p>
                        <a
                            href={project.href}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-primary-950 underline-offset-4 hover:underline"
                        >
                            Voir
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                        </a>
                    </div>
                </div>
            ))}

            <!-- Carte "prochain projet" -->
            <div class="flex flex-col items-center justify-center rounded-2xl border border-dashed border-primary-200 p-12 text-center">
                <p class="text-sm font-semibold text-primary-950">Votre site ici ?</p>
                <p class="mt-2 text-xs leading-relaxed text-primary-600">Je suis disponible pour de nouveaux projets.</p>
                <a
                    href="mailto:romain.gore@outlook.com"
                    class="mt-5 rounded-sm bg-primary-500 px-5 py-2.5 text-xs font-semibold text-white transition-colors hover:bg-primary-600"
                >
                    Démarrer un projet
                </a>
            </div>
        </div>

    </div>
    </div>
</section>
