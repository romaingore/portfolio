---
import { FEATURES } from "@/config/site";

const icons: Record<string, string> = {
    speed: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />`,
    seo: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-4.35-4.35M17 11A6 6 0 115 11a6 6 0 0112 0z" />`,
    mobile: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />`,
    human: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />`,
    analytics: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />`,
    maintenance: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z" />`,
};
---

<section id="arguments" class="bg-primary-50 py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="mx-auto max-w-2xl text-center">
            <span
                class="text-xs font-semibold uppercase tracking-[0.15em] text-primary-500"
            >
                Pourquoi moi
            </span>
            <h2
                class="mt-3 font-serif text-4xl font-semibold text-primary-950 sm:text-5xl"
            >
                Ce que vous gagnez vraiment
            </h2>
            <p class="mt-4 text-lg leading-relaxed text-primary-800">
                Pas de jargon technique. Juste ce qui compte pour votre
                activité.
            </p>
        </div>

        <!-- Grid -->
        <div
            id="features-grid"
            class="mt-16 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3"
        >
            {
                FEATURES.map((feature) => (
                    <div class="group rounded-xl border border-primary-100 bg-white p-7 transition-all hover:border-primary-300 hover:shadow-sm">
                        <div class="mb-5 inline-flex h-11 w-11 items-center justify-center rounded-lg bg-primary-50 text-primary-500 transition-colors group-hover:bg-primary-500 group-hover:text-white">
                            <svg
                                class="h-5 w-5"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                aria-hidden="true"
                            >
                                <Fragment
                                    set:html={
                                        icons[feature.icon] || icons.speed
                                    }
                                />
                            </svg>
                        </div>
                        <h3 class="font-serif text-xl font-semibold text-primary-950">
                            {feature.title}
                        </h3>
                        <p class="mt-2 text-sm leading-relaxed text-primary-700">
                            {feature.description}
                        </p>
                    </div>
                ))
            }
        </div>
    </div>
</section>
