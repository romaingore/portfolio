---
import { MENU_ITEMS } from "@/config/site";
---

<!-- Wrapper sticky avec marges latérales pour l'effet "floating" -->
<header id="site-header" class="fixed left-0 right-0 z-40 px-4 sm:px-6 lg:px-8" style="top: 8px; transition: top 0.4s ease;">
    <div
        id="header-bg"
        class="mx-auto flex max-w-6xl items-center justify-between rounded-2xl px-6 py-3"
        style="border: 1px solid transparent; background: transparent; box-shadow: none; backdrop-filter: blur(0px); transition: background 0.5s ease, border-color 0.5s ease, box-shadow 0.5s ease, backdrop-filter 0.5s ease;"
    >
        <!-- Logo: "ROMAIN," bold + "GORÉ" léger -->
        <a
            href="/"
            id="header-logo"
            class="font-serif text-xl font-semibold tracking-wide transition-all duration-300"
            aria-label="Accueil"
        >
            <span class="inline-block bg-gradient-to-b from-primary-400 to-primary-950 bg-clip-text text-transparent pb-1"><span class="text-2xl">Romain</span> <span class="text-2xl">Goré</span></span>
            <span class="block text-[10px] font-sans font-medium tracking-widest uppercase text-primary-400">Développeur web</span>
        </a>

        <!-- Desktop nav -->
        <nav class="hidden items-center gap-8 md:flex">
            {
                MENU_ITEMS.map((item) => (
                    <a
                        href={item.href}
                        class="relative text-xs font-semibold uppercase tracking-widest text-primary-700 transition-colors hover:text-primary-950 after:absolute after:-bottom-1 after:left-0 after:h-px after:w-0 after:bg-primary-950 after:transition-all after:duration-300 hover:after:w-full"
                    >
                        {item.text}
                    </a>
                ))
            }
        </nav>

        <!-- Mobile burger -->
        <button
            id="menu-toggle"
            class="rounded-md p-1.5 text-primary-700 hover:bg-primary-100 focus:outline-none focus:ring-2 focus:ring-primary-500 md:hidden"
            aria-label="Ouvrir le menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
        >
            <svg
                class="h-5 w-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
        </button>
    </div>

    <!-- Mobile menu (sous le conteneur flottant) -->
    <div
        id="mobile-menu"
        class="mx-auto mt-2 hidden max-w-6xl overflow-hidden rounded-2xl border border-primary-200/60 bg-white/95 shadow-sm backdrop-blur-sm"
    >
        <nav class="flex flex-col px-6 py-4">
            {
                MENU_ITEMS.map((item) => (
                    <a
                        href={item.href}
                        class="py-3 text-xs font-semibold uppercase tracking-widest text-primary-700 transition-colors hover:text-primary-500 border-b border-primary-100 last:border-0"
                    >
                        {item.text}
                    </a>
                ))
            }
        </nav>
    </div>
</header>

<script>
    const headerBg = document.getElementById("header-bg");
    const header = document.getElementById("site-header");

    window.addEventListener("scroll", () => {
        if (window.scrollY > 80) {
            if (headerBg) {
                headerBg.style.background = "rgba(255,255,255,0.9)";
                headerBg.style.borderColor = "rgba(160,160,160,0.25)";
                headerBg.style.boxShadow = "0 1px 8px rgba(0,0,0,0.06)";
                headerBg.style.backdropFilter = "blur(12px)";
            }
            if (header) header.style.top = "16px";
        } else {
            if (headerBg) {
                headerBg.style.background = "transparent";
                headerBg.style.borderColor = "transparent";
                headerBg.style.boxShadow = "none";
                headerBg.style.backdropFilter = "blur(0px)";
            }
            if (header) header.style.top = "8px";
        }
    }, { passive: true });

    const menuToggle = document.getElementById("menu-toggle");
    const mobileMenu = document.getElementById("mobile-menu");

    if (menuToggle && mobileMenu) {
        menuToggle.addEventListener("click", () => {
            const isExpanded =
                menuToggle.getAttribute("aria-expanded") === "true";
            menuToggle.setAttribute("aria-expanded", String(!isExpanded));
            mobileMenu.classList.toggle("hidden");
        });
    }
</script>
