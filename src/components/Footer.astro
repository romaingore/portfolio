---
import { MENU_ITEMS, SITE } from "@/config/site";
---

<footer class="bg-primary-950 text-white">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-12 md:grid-cols-3">

            <!-- Brand -->
            <div>
                <a href="/" class="font-serif text-2xl font-semibold text-white">
                    Romain Goré
                </a>
                <p class="mt-1 text-xs font-medium uppercase tracking-widest text-white/40">Développeur web</p>
                <p class="mt-4 text-sm leading-relaxed text-white/60">
                    Sites sur mesure pour artisans et petites entreprises locales. Rapides, visibles sur Google, livrés en 1 à 4 semaines.
                </p>
            </div>

            <!-- Navigation -->
            <div>
                <p class="text-xs font-semibold uppercase tracking-widest text-white/40">Navigation</p>
                <ul class="mt-4 space-y-2">
                    {MENU_ITEMS.map((item) => (
                        <li>
                            <a
                                href={item.href}
                                class="text-sm text-white/70 transition-colors hover:text-white"
                            >
                                {item.text}
                            </a>
                        </li>
                    ))}
                </ul>
            </div>

            <!-- Contact -->
            <div>
                <p class="text-xs font-semibold uppercase tracking-widest text-white/40">Contact</p>
                <ul class="mt-4 space-y-2">
                    <li>
                        <a href="mailto:romain.gore@outlook.com" class="text-sm text-white/70 transition-colors hover:text-white">
                            romain.gore@outlook.com
                        </a>
                    </li>
                </ul>
            </div>

        </div>

        <!-- Bottom bar -->
        <div class="mt-16 border-t border-white/10 pt-8">
            <p class="text-center text-xs text-white/30">
                © {new Date().getFullYear()} {SITE.name}
            </p>
        </div>
    </div>
</footer>
